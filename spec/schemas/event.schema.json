{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aifred:event",
  "title": "Event log entry",
  "description": "One append-only log per market region carries transitions, timers, step events and the actions people take on the board. It carries aliases and pseudonymous references only.",
  "x-locus": "02-architecture/index.html#table:2.9",
  "type": "object",
  "properties": {
    "event_id": { "$ref": "aifred:common#/$defs/event-id" },
    "task_id": { "$ref": "aifred:common#/$defs/task-id" },
    "step_id": { "$ref": "aifred:common#/$defs/step-id" },
    "at": { "$ref": "aifred:common#/$defs/timestamp" },
    "kind": { "$ref": "aifred:vocab#/$defs/event-kinds" },
    "actor": { "$ref": "aifred:common#/$defs/actor" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "transition": { "$ref": "aifred:vocab#/$defs/transitions" },
    "reason": { "type": "string" },
    "timer_set": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "properties": { "kind": { "$ref": "aifred:vocab#/$defs/timers" }, "due": { "$ref": "aifred:common#/$defs/timestamp" }, "task_type": { "$ref": "aifred:common#/$defs/task-type" } }, "required": ["kind"], "additionalProperties": false }
      ]
    },
    "task_type": { "$ref": "aifred:common#/$defs/task-type" },
    "timer": { "$ref": "aifred:vocab#/$defs/timers" },
    "due": { "$ref": "aifred:common#/$defs/timestamp" },
    "supersedes": { "anyOf": [{ "$ref": "aifred:common#/$defs/event-id" }, { "type": "null" }] },
    "consequence": { "type": "string" },
    "ordinal": { "type": "integer", "minimum": 1 },
    "channel": { "$ref": "aifred:vocab#/$defs/channels" },
    "device": { "$ref": "aifred:common#/$defs/device-id" },
    "plan_id": { "$ref": "aifred:common#/$defs/plan-id" },
    "validator_errors": { "type": "array", "items": { "type": "string" } },
    "cause": { "type": "string" },
    "code": { "$ref": "aifred:vocab#/$defs/outcome-codes" },
    "fields": { "type": "object" },
    "closed_by": { "type": "object" },
    "checked_by": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
    "artefacts": { "type": "array", "items": { "$ref": "aifred:common#/$defs/artefact-id" } },
    "check_id": { "$ref": "aifred:common#/$defs/check-id" },
    "checker": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
    "decision": { "type": "string", "enum": ["approve", "decline"] },
    "token": { "$ref": "aifred:common#/$defs/token-id" },
    "context_id": { "$ref": "aifred:common#/$defs/context-id" },
    "envelope_version": { "$ref": "aifred:common#/$defs/envelope-version-ref" },
    "expiry": { "$ref": "aifred:common#/$defs/timestamp" },
    "placement_id": { "$ref": "aifred:common#/$defs/placement-id" },
    "receipt": { "$ref": "aifred:vocab#/$defs/placement-statuses" },
    "question_id": { "$ref": "aifred:common#/$defs/question-id" },
    "step_blocked": { "anyOf": [{ "$ref": "aifred:common#/$defs/step-id" }, { "type": "null" }] },
    "fact_written": { "anyOf": [{ "$ref": "aifred:common#/$defs/fact-id" }, { "type": "null" }] },
    "new_due": { "$ref": "aifred:common#/$defs/timestamp" },
    "party": { "$ref": "aifred:common#/$defs/party-id" },
    "step_type": { "$ref": "aifred:common#/$defs/step-type" },
    "market": { "$ref": "aifred:common#/$defs/market" },
    "column": { "$ref": "aifred:vocab#/$defs/board-columns" },
    "condition": { "type": "string" },
    "action": { "$ref": "aifred:vocab#/$defs/board-actions" },
    "class": { "$ref": "aifred:vocab#/$defs/incident-classes" },
    "rule": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "alias": { "anyOf": [{ "$ref": "aifred:common#/$defs/alias" }, { "type": "null" }] },
    "incident_id": { "$ref": "aifred:common#/$defs/incident-id" }
  },
  "required": ["event_id", "task_id", "at", "kind", "actor"],
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "kind": { "const": "transition" } } }, "then": { "required": ["from", "to", "transition", "reason"], "properties": { "from": { "$ref": "aifred:vocab#/$defs/states" }, "to": { "$ref": "aifred:vocab#/$defs/states" } } } },
    { "if": { "properties": { "kind": { "enum": ["timer-set", "timer-expired"] } } }, "then": { "required": ["timer", "due", "supersedes"] } },
    { "if": { "properties": { "kind": { "const": "nudge" } } }, "then": { "required": ["ordinal", "channel", "device"] } },
    { "if": { "properties": { "kind": { "const": "nudge-reset" } } }, "then": { "required": ["channel"] } },
    { "if": { "properties": { "kind": { "enum": ["plan-produced", "plan-rejected", "plan-superseded"] } } }, "then": { "required": ["plan_id"] } },
    { "if": { "properties": { "kind": { "const": "plan-rejected" } } }, "then": { "required": ["validator_errors"] } },
    { "if": { "properties": { "kind": { "const": "plan-superseded" } } }, "then": { "required": ["supersedes"] } },
    { "if": { "properties": { "kind": { "const": "step-state" } } }, "then": { "required": ["step_id", "from", "to", "cause"], "properties": { "from": { "$ref": "aifred:vocab#/$defs/step-states" }, "to": { "$ref": "aifred:vocab#/$defs/step-states" } } } },
    { "if": { "properties": { "kind": { "const": "outcome" } } }, "then": { "required": ["step_id", "code", "fields", "closed_by", "checked_by", "artefacts"] } },
    { "if": { "properties": { "kind": { "enum": ["check-requested", "check-decided", "token-issued", "token-voided"] } } }, "then": { "required": ["step_id", "check_id"] } },
    { "if": { "properties": { "kind": { "const": "check-decided" } } }, "then": { "required": ["decision", "reason"] } },
    { "if": { "properties": { "kind": { "enum": ["token-issued", "token-voided"] } } }, "then": { "required": ["token"] } },
    { "if": { "properties": { "kind": { "enum": ["context-issued", "context-voided"] } } }, "then": { "required": ["step_id", "context_id", "envelope_version"] } },
    { "if": { "properties": { "kind": { "const": "context-issued" } } }, "then": { "required": ["expiry"] } },
    { "if": { "properties": { "kind": { "const": "placement" } } }, "then": { "required": ["step_id", "placement_id", "receipt"] } },
    { "if": { "properties": { "kind": { "const": "question-asked" } } }, "then": { "required": ["question_id", "step_blocked"] } },
    { "if": { "properties": { "kind": { "const": "question-answered" } } }, "then": { "required": ["question_id", "fact_written"] } },
    { "if": { "properties": { "kind": { "enum": ["extend-window", "extend-planning"] } } }, "then": { "required": ["new_due"] } },
    { "if": { "properties": { "kind": { "const": "extend-window" } } }, "then": { "required": ["party"] } },
    { "if": { "properties": { "kind": { "const": "catalogue-request" } } }, "then": { "required": ["step_type", "market"] } },
    { "if": { "properties": { "kind": { "const": "board-entry" } } }, "then": { "required": ["column", "condition"] } },
    { "if": { "properties": { "kind": { "const": "board-action" } } }, "then": { "required": ["column", "action"], "properties": { "actor": { "type": "object", "properties": { "kind": { "const": "person" }, "id": { "$ref": "aifred:common#/$defs/staff-id" }, "role": { "$ref": "aifred:vocab#/$defs/board-roles" } }, "required": ["kind", "id", "role"] } } } },
    { "if": { "properties": { "kind": { "const": "incident" } } }, "then": { "required": ["incident_id", "class", "rule", "alias"] } }
  ]
}
