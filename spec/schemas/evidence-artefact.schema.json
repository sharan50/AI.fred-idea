{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aifred:evidence-artefact",
  "title": "Evidence artefact",
  "description": "Identified as ev_<task>_<step>_<kind>; carries the step reference, the capture point, the surface's clock, the placement registry and, once redacted, the manifest: one entry per mask applied, in aliases, naming the rule, the region and the registry entry it came from. Raw content exists only in the pipeline's memory; the store accepts an artefact only with the verifier's signature over its hash.",
  "x-locus": "02-architecture/index.html#evidence-contract",
  "type": "object",
  "properties": {
    "artefact_id": { "$ref": "aifred:common#/$defs/artefact-id" },
    "task_id": { "$ref": "aifred:common#/$defs/task-id" },
    "step_id": { "$ref": "aifred:common#/$defs/step-id" },
    "kind": { "$ref": "aifred:vocab#/$defs/evidence-kinds" },
    "capture_point": { "type": "string", "enum": ["before-submit", "after-response", "call-end", "on-delivery", "on-device-response"] },
    "surface_clock": { "$ref": "aifred:common#/$defs/timestamp" },
    "stage": { "type": "string", "enum": ["captured", "redacted", "verified", "stored", "quarantined", "withheld"] },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "placement_id": { "$ref": "aifred:common#/$defs/placement-id" },
          "alias": { "$ref": "aifred:common#/$defs/alias" },
          "rectangle": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } }, "required": ["x", "y", "w", "h"], "additionalProperties": false },
          "window": { "type": "object", "properties": { "start_ms": { "type": "integer" }, "end_ms": { "type": "integer" } }, "required": ["start_ms", "end_ms"], "additionalProperties": false },
          "occurrence": { "type": "integer", "minimum": 0 },
          "frame": { "type": "integer", "minimum": 0 }
        },
        "required": ["placement_id", "alias"],
        "additionalProperties": false
      }
    },
    "manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": { "$ref": "aifred:vocab#/$defs/redaction-masks" },
          "region": { "type": "string" },
          "registry_entry": { "anyOf": [{ "$ref": "aifred:common#/$defs/placement-id" }, { "type": "null" }] },
          "alias": { "anyOf": [{ "$ref": "aifred:common#/$defs/alias" }, { "type": "null" }] },
          "marker": { "anyOf": [{ "type": "string", "enum": ["alias", "span-masked", "silence", "paint"] }, { "type": "null" }] }
        },
        "required": ["rule", "region", "registry_entry", "alias"],
        "additionalProperties": false
      }
    },
    "content": { "description": "Stage-specific; opaque to this schema. Raw content never leaves the pipeline's memory." },
    "verifier": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "properties": { "hash": { "$ref": "aifred:common#/$defs/hex-digest" }, "signature": { "$ref": "aifred:common#/$defs/signature" }, "key_id": { "$ref": "aifred:common#/$defs/key-id" }, "attempts": { "type": "integer", "minimum": 1 } }, "required": ["hash", "signature", "key_id", "attempts"], "additionalProperties": false }
      ]
    }
  },
  "required": ["artefact_id", "task_id", "step_id", "kind", "capture_point", "surface_clock", "stage", "registry", "manifest", "verifier"],
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "stage": { "const": "stored" } } }, "then": { "properties": { "verifier": { "type": "object" } } } },
    { "if": { "properties": { "stage": { "const": "withheld" } } }, "then": { "properties": { "content": { "type": "null" } } } }
  ]
}
